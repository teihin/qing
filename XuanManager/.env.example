# XuanManager 只允许后端连接服务器本机 MySQL。
XUAN_HTTP_ADDR=127.0.0.1:8891
XUAN_DB_HOST=127.0.0.1
XUAN_DB_PORT=3306
XUAN_DB_NAME=webcm
XUAN_DB_USER=replace-me
XUAN_DB_PASSWORD=replace-me
XUAN_GAME_ADMIN_URL=http://127.0.0.1:8890
XUAN_COOKIE_SECURE=false
XUAN_SESSION_TTL=8h

# 仅首次初始化时设置；首个超级管理员创建成功后应从运行环境移除密码。
XUAN_BOOTSTRAP_ADMIN_USERNAME=replace-me
XUAN_BOOTSTRAP_ADMIN_PASSWORD=replace-me
XUAN_BOOTSTRAP_ADMIN_NAME=超级管理员
