# XuanManager 只允许后端连接服务器本机 MySQL。
XUAN_HTTP_ADDR=127.0.0.1:8891
XUAN_DB_HOST=127.0.0.1
XUAN_DB_PORT=3306
XUAN_DB_NAME=webcm
XUAN_DB_USER=replace-me
XUAN_DB_PASSWORD=replace-me
# 发牌优化使用独立的本机游戏库写连接；真实凭据只放运行环境。
XUAN_GAME_DB_HOST=127.0.0.1
XUAN_GAME_DB_PORT=3306
XUAN_GAME_DB_NAME=kbedm
XUAN_GAME_DB_USER=replace-me
XUAN_GAME_DB_PASSWORD=replace-me
XUAN_GAME_ADMIN_URL=http://127.0.0.1:8890
# 只在正式8891进程启用；本地和候选端口必须保持false，避免重复全服轮播。
XUAN_NOTIFICATION_CAROUSEL_WORKER=false
# 玩家加减分签名仅放在服务器受控运行环境，不得提交真实值。
XUAN_GAME_EXCHANGE_SIGN=replace-me
XUAN_COOKIE_SECURE=false
XUAN_SESSION_TTL=8h

# 仅首次初始化时设置；首个超级管理员创建成功后应从运行环境移除密码。
XUAN_BOOTSTRAP_ADMIN_USERNAME=replace-me
XUAN_BOOTSTRAP_ADMIN_PASSWORD=replace-me
XUAN_BOOTSTRAP_ADMIN_NAME=超级管理员
