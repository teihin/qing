# ChatTool 仅监听服务器本机，由同机 Caddy 通过公网 IP 的 /chattool/ 路径提供纯 HTTP 访问。
CHAT_HTTP_ADDR=127.0.0.1:8893
CHAT_PUBLIC_BASE_URL=http://154.37.155.17/chattool
CHAT_MESSAGE_RETENTION=48h
CHAT_STATIC_DIR=../web/dist
CHAT_UPLOAD_DIR=../data/uploads
# 用户已明确选择纯 HTTP，因此 Secure Cookie 必须关闭；HttpOnly、SameSite 与 CSRF 仍保留。
CHAT_COOKIE_SECURE=false

# ChatTool 自有表统一放在 webcm，账号只需要 chat_* 表和 chat_schema_migration 的权限。
CHAT_DB_HOST=127.0.0.1
CHAT_DB_PORT=3306
CHAT_DB_NAME=webcm
CHAT_DB_USER=
CHAT_DB_PASSWORD=

# 游戏客户端用户资料链接的轻量加密口令，必须与Cocos端Tool.encrypt最终实际使用的口令一致。
# panelKefu传空字符串时，需填写Tool.aesKeyBytes内部采用的有效默认口令，不能在这里也留空。
# 该口令会随客户端发布，只用于避免普通用户直接看懂URL，不可视为可靠身份认证。
CHAT_PLAYER_LINK_KEY=
CHAT_PLAYER_LINK_TTL=15m

# 仅首次启动且 chat_agent 为空时使用；首次成功后从运行环境移除密码。
CHAT_BOOTSTRAP_USERNAME=
CHAT_BOOTSTRAP_PASSWORD=
CHAT_BOOTSTRAP_NAME=客服主管

CHAT_AGENT_SESSION_TTL=12h
CHAT_PLAYER_SESSION_TTL=24h
CHAT_AGENT_OFFLINE_AFTER=90s
CHAT_CONVERSATION_IDLE=24h
CHAT_MAX_IMAGE_BYTES=10485760
CHAT_MAX_VIDEO_BYTES=104857600
CHAT_MAX_FILE_BYTES=26214400

# 俱乐部 1 对 1 私聊（direct chat）。与客服完全分离：独立表 chat_direct_*、独立路由 /api/direct/*。
# 客服保留期 CHAT_MESSAGE_RETENTION 不受影响，直聊用下面的 CHAT_DIRECT_RETENTION。
CHAT_DIRECT_RETENTION=720h
CHAT_DIRECT_SESSION_TTL=168h
# 游戏票据校验密钥（至少 16 字符）。缺失时直聊接口一律返回 DIRECT_AUTH_REQUIRED，
# 不会退化为信任客户端自报的 guuid。游戏服与本服务必须配置同一份密钥。
CHAT_DIRECT_TICKET_KEY=
# 语音复用现有 AudioServer；时长上下限必须与 AudioServer/config.json 的实际限制一致。
CHAT_DIRECT_AUDIO_BASE_URL=http://154.37.155.17/audio
CHAT_DIRECT_MIN_VOICE_MS=300
CHAT_DIRECT_MAX_VOICE_MS=10000
CHAT_DIRECT_MEDIA_TICKET_TTL=10m
# 仅本地联调：允许 /api/direct/session/dev 用 guuid 直接换会话。生产必须为 false。
CHAT_DIRECT_ALLOW_DEV_LOGIN=false
# 仅允许这些网页来源调用俱乐部直聊 API；多个来源用英文逗号分隔。
CHAT_DIRECT_CORS_ORIGINS=http://localhost:7456,http://127.0.0.1:7456,https://154-37-155-17.nip.io

# 游戏俱乐部目录只读连接。聊天库仍使用 webcm，目录从 kbedm 实时查询。
# 该账号只应授予 kbedm.* 的 SELECT 权限。
CHAT_GAME_DB_HOST=127.0.0.1
CHAT_GAME_DB_PORT=3306
CHAT_GAME_DB_NAME=kbedm
CHAT_GAME_DB_USER=
CHAT_GAME_DB_PASSWORD=
